--- a/crates/designos-app/src/styles.rs
+++ b/crates/designos-app/src/styles.rs
@@ -88,7 +88,13 @@ impl App {
             }
             Style::Fill(paints) => {
                 match &mut n.kind {
-                    NodeKind::Text(t) => t.style.fills = paints.clone(),
+                    NodeKind::Text(t) => {
+                        // Runs carry their own colour and are what is painted: recolour them all.
+                        t.style.fills = paints.clone();
+                        for r in &mut t.runs {
+                            r.style.fills = paints.clone();
+                        }
+                    }
                     _ => n.fills = paints.clone(),
                 }
                 n.style_refs.insert("fill".into(), key.into());
diff --git a/crates/designos-doc/src/variables_apply.rs b/crates/designos-doc/src/variables_apply.rs
