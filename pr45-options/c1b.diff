-/// Whether a visible layer painted before `id` (an earlier sibling of it or of any ancestor) covers
-/// part of it. Such a layer is behind the text and the ancestor chain does not describe it.
+/// Nodes one text check may look at in earlier siblings' subtrees. Past it the backdrop is unknown.
+const SUBTREE_BUDGET: usize = 4096;
+
+/// Whether the box of `id` or of any visible descendant overlaps `text_box`. Geometry only: what the
+/// layers paint is not looked at, so an unpainted overlap counts too. A frame that clips cuts its
+/// children to its own box, so its subtree is skipped when the frame itself misses the text.
+fn subtree_overlaps(doc: &Document, id: NodeId, text_box: &Rect, budget: &mut usize) -> bool {
+    let Some(n) = doc.get(id) else { return false };
+    if !n.visible || n.opacity <= 0.0 {
+        return false;
+    }
+    if *budget == 0 {
+        return true;
+    }
+    *budget -= 1;
+    let Some(own) = page_box(doc, id) else { return true };
+    let hit = own.intersects(text_box);
+    let clips = n.kind.frame_props().is_some_and(|f| f.clips_content);
+    hit || (!clips && n.children.iter().any(|c| subtree_overlaps(doc, *c, text_box, budget)))
+}
