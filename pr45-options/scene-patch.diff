diff --git a/crates/designos-app/src/check_designs/tests/probe.rs b/crates/designos-app/src/check_designs/tests/probe.rs
new file mode 100644
index 0000000..1cb55b3
--- /dev/null
+++ b/crates/designos-app/src/check_designs/tests/probe.rs
@@ -0,0 +1,130 @@
+//! Evidence probe: per scene, what the audit lists, what the Fix does, and what the CPU renderer
+//! really paints afterwards. Prints one `PROBE` line per scene (`-- probe --nocapture`); asserts
+//! only what holds for every option.
+
+use super::*;
+use crate::check_designs::contrast::contrast_ratio;
+use crate::check_designs::scenes::{self, BLUE, NAMES, RED};
+use designos_doc::{resolved_node, Vec2};
+use designos_render::tiny_skia::Pixmap;
+use designos_render::{render_page, Viewport};
+
+fn render(doc: &Document, page: NodeId) -> Pixmap {
+    let mut pm = Pixmap::new(900, 400).expect("pixmap");
+    render_page(doc, page, &Viewport::default(), &mut pm);
+    pm
+}
+
+fn px(pm: &Pixmap, x: u32, y: u32) -> Color {
+    let p = pm.pixel(x, y).expect("inside the pixmap").demultiply();
+    Color::rgb(p.red(), p.green(), p.blue())
+}
+
+/// The text box in page space as integer pixel bounds.
+fn text_box(doc: &Document, text: NodeId) -> (u32, u32, u32, u32) {
+    let n = doc.get(text).expect("text");
+    let t = doc.world_transform(text);
+    let (a, b) = (t.apply(Vec2::new(0.0, 0.0)), t.apply(Vec2::new(n.size.x, n.size.y)));
+    (a.x.max(0.0) as u32, a.y.max(0.0) as u32, (b.x.ceil() as u32).min(899), (b.y.ceil() as u32).min(399))
+}
+
+/// What the renderer shows behind the text: the page painted without the text layer, at the
+/// middle of its box.
+fn true_backdrop(doc: &Document, page: NodeId, text: NodeId) -> Color {
+    let mut bare = doc.clone();
+    bare.get_mut(text).expect("text").visible = false;
+    let (x0, y0, x1, y1) = text_box(doc, text);
+    px(&render(&bare, page), (x0 + x1) / 2, (y0 + y1) / 2)
+}
+
+fn base_and_runs(doc: &Document, text: NodeId) -> String {
+    let n = resolved_node(doc, text).expect("text");
+    let NodeKind::Text(t) = &n.kind else { return String::new() };
+    let hex = |ps: &[Paint]| match ps.first().map(|p| &p.kind) {
+        Some(PaintKind::Solid(c)) => format!("#{}", c.to_hex()),
+        _ => "-".to_string(),
+    };
+    let runs: Vec<String> = t.runs.iter().map(|r| hex(&r.style.fills)).collect();
+    format!("base={} runs=[{}]", hex(&t.style.fills), runs.join(" "))
+}
+
+/// Rough glyph colour census inside the text box on a black page: blue / red / white pixels.
+fn census(doc: &Document, page: NodeId, text: NodeId) -> String {
+    let pm = render(doc, page);
+    let (x0, y0, x1, y1) = text_box(doc, text);
+    let norm = |c: Color| {
+        let m = c.r.max(c.g).max(c.b).max(1e-3);
+        (c.r / m, c.g / m, c.b / m)
+    };
+    let refs = [("blue", norm(BLUE)), ("red", norm(RED)), ("white", norm(Color::WHITE))];
+    let mut counts = [0u32; 3];
+    for y in y0..y1 {
+        for x in x0..x1 {
+            let c = px(&pm, x, y);
+            if c.r.max(c.g).max(c.b) < 0.45 {
+                continue;
+            }
+            let (r, g, b) = norm(c);
+            let d = |(rr, gg, bb): (f32, f32, f32)| (r - rr).powi(2) + (g - gg).powi(2) + (b - bb).powi(2);
+            let best = (0..3).min_by(|a, b| d(refs[*a].1).total_cmp(&d(refs[*b].1))).unwrap_or(0);
+            counts[best] += 1;
+        }
+    }
+    format!("glyph px blue/red/white = {}/{}/{}", counts[0], counts[1], counts[2])
+}
+
+fn listing(report: &Report) -> String {
+    let rows: Vec<String> = report.findings.iter().map(|f| format!("{:?}:{}{}", f.rule, f.message, f.fix.as_ref().map_or(String::new(), |_| format!(" -> {}", f.fix_label)))).collect();
+    format!("{} [{}]", rows.len(), rows.join(" | "))
+}
+
+#[test]
+fn probe() {
+    for name in NAMES {
+        let scene = scenes::build(name).expect("known scene");
+        let (page, text, rule, variable) = (scene.page, scene.text, scene.rule, scene.variable);
+        let mut app = App::new(scene.doc);
+        app.page = page;
+        let before = audit(&app.doc, &Scope::Page(page));
+        let backdrop = true_backdrop(&app.doc, page, text);
+        let vs = |app: &App| match resolved_node(&app.doc, text).map(|n| n.kind.clone()) {
+            Some(NodeKind::Text(t)) => match t.style.fills.first().map(|p| &p.kind) {
+                Some(PaintKind::Solid(c)) => format!("{:.2}:1", contrast_ratio(*c, backdrop)),
+                _ => "-".into(),
+            },
+            _ => "-".into(),
+        };
+        let ratio_before = vs(&app);
+        let mut lines = vec![format!("PROBE {name}"), format!("  before : findings {}", listing(&before))];
+        if variable.is_some() {
+            lines.push(format!("  start  : {}  ({})", base_and_runs(&app.doc, text), census(&app.doc, page, text)));
+        }
+        let fixed = scenes::fix_scene(&mut app, rule);
+        lines.push(format!("  fix    : {}", fixed.as_ref().map_or("none (no fixable finding)".to_string(), |f| f.fix_label.clone())));
+        if let Some(v) = variable {
+            lines.push(format!("  bound  : {}  ({})", base_and_runs(&app.doc, text), census(&app.doc, page, text)));
+            scenes::turn_variable_white(&mut app, v);
+            lines.push(format!("  white  : {}  ({})", base_and_runs(&app.doc, text), census(&app.doc, page, text)));
+        } else {
+            lines.push(format!("  text   : {}", base_and_runs(&app.doc, text)));
+            lines.push(format!(
+                "  truth  : backdrop behind text #{} | real contrast before {} -> after {} (backdrop after #{})",
+                backdrop.to_hex(),
+                ratio_before,
+                vs(&app),
+                true_backdrop(&app.doc, page, text).to_hex()
+            ));
+        }
+        lines.push(format!("  after  : findings {}", listing(&audit(&app.doc, &Scope::Page(page)))));
+        println!("{}", lines.join("\n"));
+    }
+}
+
+#[test]
+fn the_earlier_frame_of_the_evidence_scenes_really_does_not_clip() {
+    for name in ["s1", "s1g", "s3", "s3b"] {
+        let scene = scenes::build(name).expect("known scene");
+        let earlier = scene.doc.nodes.values().find(|n| n.name == "Earlier").expect("earlier frame");
+        assert!(!earlier.kind.frame_props().expect("a frame").clips_content, "{name}: the earlier frame must not clip its child");
+    }
+}
